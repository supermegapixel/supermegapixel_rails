# TrustBuilder configuration. Copy to .env (git-ignored) and fill in.
# Never commit real values. Production reads these from the host's secret store.

# development | test | production. Production refuses to start on fixture data.
TRUSTBUILDER_ENV=development

# Comma-separated SHA-256 hex digests of the accepted API keys, never the keys themselves.
# Generate a key and its digest with: uv run python -m trustbuilder.keys
TRUSTBUILDER_API_KEY_SHA256=

# Data store. Only "fixture" exists until the Postgres store lands (PLAN.md §6, S0).
TRUSTBUILDER_STORE=fixture

# --- Not read by the code yet. The names are settled here; leave them unset until the
# --- Phase 0 spike or phase that needs them (PLAN.md §6).

# S0 foundations: Postgres + pgvector, S3-compatible object storage
# DATABASE_URL=
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# S3 claim extraction: Anthropic API key and the pinned model IDs for each tier
# ANTHROPIC_API_KEY=
# TRUSTBUILDER_EXTRACTION_MODEL=
# TRUSTBUILDER_CLASSIFIER_MODEL=

# S4 fact-check match rate: Google Fact Check Tools API
# GOOGLE_FACT_CHECK_API_KEY=

# S6 FOIA scoping: FOIA.gov API (agency component directory)
# FOIA_GOV_API_KEY=

# Phase 1 web search adapter
# SEARCH_API_KEY=
